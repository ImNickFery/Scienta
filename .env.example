# Scienta Runtime Configuration
# Copy to .env on the server and set strong production values.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Required in production: at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Optional MySQL 8.0 / MariaDB 10.6 connection (cPanel MySQL Databases).
# Leave DB_HOST empty to use the built-in zero-config SQLite database automatically.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=scienta
DB_POOL_SIZE=10

# Persistent SQLite path used automatically when DB_HOST is empty or unreachable
SQLITE_FALLBACK_PATH=data/scienta.sqlite

# Optional initial super-admin credentials for scripts/seed.mjs
SEED_ADMIN_EMAIL=admin@scienta.ir
SEED_ADMIN_PASSWORD=

# Optional SEO & Webmaster Verification tokens (loaded at runtime on server restart)
NEXT_PUBLIC_SITE_URL=https://scienta.ir
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Optional Analytics & Tag Managers (loaded at runtime from .env — no rebuild needed)
# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
GTM_ID=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
# Microsoft Clarity project ID (e.g. abc123def4)
CLARITY_ID=
# Yandex Metrika numeric counter ID (e.g. 98765432)
YANDEX_METRIKA_ID=
